<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>COA Exporter</name>
    <id>org.inkscape.coa_export</id>

    <!-- 导出路径与文件名设置 -->
    <param name="export_path" type="path" mode="folder" gui-text="导出保存路径">~/</param>
    <param name="export_name" type="string" gui-text="导出对象名/JSON文件名">Actor_Goblin</param>

    <!-- 命名与分辨率设置 -->
    <param name="suffix" type="string" gui-text="导出命名的后缀 (留空则无)"></param>
    <param name="dpi" type="int" min="1" max="1200" gui-text="DPI (图像分辨率)">96</param>

    <!-- 是否覆盖文件 -->
    <param name="overwrite" type="bool" gui-text="默认覆盖已有文件">true</param>

    <label>提示：该插件会批量导出当前选中的对象到指定路径下的 "sprites" 文件夹，并生成一份 JSON 格式的元数据文件。</label>

    <effect needs-live-preview="false">
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="Export"/>
        </effects-menu>
    </effect>

    <script>
        <command location="inx" interpreter="python">coa_export.py</command>
    </script>
</inkscape-extension>